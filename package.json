{
  "name": "loop-miniapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Loop — shared tabs that settle themselves. A Nimiq Pay mini app.",
  "scripts": {
    "dev": "vite --host",
    "dev:worker": "wrangler dev",
    "build": "vue-tsc -b --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 execute loop-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute loop-db --remote --file=./schema.sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nimiq/mini-app-sdk": "^0.1.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "hono": "^4.13.7",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@nimiq/core": "^2.21.0",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.1.3",
    "wrangler": "^4.131.1"
  }
}
